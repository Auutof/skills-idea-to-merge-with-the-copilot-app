<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL with or without <code>https://</code> to create a short <code>mona-</code> bookmark.</p>
<p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import { type Bookmark, formatBookmark, generateSlug, loadBookmarks, normalizeUrl } from '../lib/bookmarks';

  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.querySelector<HTMLFormElement>('#add-bookmark');
  const urlInput = document.querySelector<HTMLInputElement>('#url');
  const list = document.querySelector<HTMLUListElement>('#bookmark-list');
  const emptyState = document.querySelector<HTMLElement>('#empty-state');
  const listHeader = document.querySelector<HTMLElement>('#list-header');
  const status = document.querySelector<HTMLElement>('#bookmark-status');
  const clearAll = document.querySelector<HTMLButtonElement>('#clear-all');

  let bookmarks: Bookmark[] = [];

  function showStatus(message: string) {
    if (status) status.textContent = message;
  }

  function persist(nextBookmarks: typeof bookmarks): boolean {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(nextBookmarks));
      return true;
    } catch {
      showStatus('This bookmark could not be saved in your browser.');
      return false;
    }
  }

  function render() {
    if (!list) return;
    list.replaceChildren();

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';
      item.setAttribute('aria-label', formatBookmark(bookmark));

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showStatus(`Copied ${bookmark.slug}.`);
        } catch {
          showStatus('The slug could not be copied from this browser.');
        }
      });

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      item.append(link, separator, slug, copy);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = hasBookmarks;
    if (listHeader) listHeader.hidden = !hasBookmarks;
  }

  try {
    bookmarks = loadBookmarks(window.localStorage.getItem(STORAGE_KEY));
  } catch {
    showStatus('Saved bookmarks are unavailable in this browser.');
  }
  render();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      if (!urlInput) throw new Error('The URL field is unavailable.');

      const url = normalizeUrl(urlInput.value);
      const bookmark = {
        url,
        slug: generateSlug(bookmarks.map((saved) => saved.slug)),
      };
      const nextBookmarks = [...bookmarks, bookmark];

      if (!persist(nextBookmarks)) return;
      bookmarks = nextBookmarks;
      render();
      form?.reset();
      showStatus(`Saved ${bookmark.slug}.`);
    } catch (error) {
      showStatus(error instanceof Error ? error.message : 'Enter a valid URL.');
    }
  });

  clearAll?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    if (!persist([])) return;
    bookmarks = [];
    render();
    showStatus('All bookmarks cleared.');
  });
</script>
